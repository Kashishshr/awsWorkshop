{
  "name": "power-grid-simulation-backend",
  "version": "1.0.0",
  "description": "Node.js/Express backend for power grid device simulation",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "build": "tsc",
    "test": "jest --watch",
    "test:ci": "jest --coverage",
    "lint": "eslint src/**/*.js",
    "format": "prettier --write \"src/**/*.js\""
  },
  "keywords": [
    "power-grid",
    "simulation",
    "weather",
    "monitoring"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.0",
    "socket.io": "^4.5.0",
    "passport": "^0.6.0",
    "passport-jwt": "^4.0.0",
    "jsonwebtoken": "^9.0.0",
    "joi": "^17.0.0",
    "cors": "^2.8.0",
    "compression": "^1.7.0",
    "helmet": "^7.0.0",
    "winston": "^3.10.0",
    "dotenv": "^16.0.0",
    "lodash": "^4.17.0",
    "moment": "^2.29.0",
    "uuid": "^9.0.0",
    "validator": "^13.0.0",
    "bcryptjs": "^2.4.0",
    "sequelize": "^6.35.0",
    "pg": "^8.11.0",
    "redis": "^4.6.0",
    "axios": "^1.6.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.0",
    "jest": "^29.0.0",
    "supertest": "^6.3.0",
    "eslint": "^8.50.0",
    "prettier": "^3.0.0",
    "typescript": "^5.2.0",
    "@types/express": "^4.17.0",
    "@types/node": "^20.0.0",
    "@types/jest": "^29.0.0"
  }
}
